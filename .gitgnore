# ==========================================
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ==========================================
# Never commit third-party libraries installed by package managers
node_modules/
jspm_packages/
web_modules/
vendor/
.pnp
.pnp.js

# Python virtual environments
.venv/
venv/
env/
ENV/

# ==========================================
# 2. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# Crucial to ignore to prevent leaking passwords, API keys, and credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials.json

# ==========================================
# 3. BUILD OUTPUTS, ARTIFACTS & DISTRIBUTIONS
# ==========================================
# Ignore folder structures generated by bundlers and compilers
dist/
build/
out/
.next/
.nuxt/
*.egg-info/
*.pyc
*.class
*.o
*.exe

# ==========================================
# 4. LOGS & DIAGNOSTICS
# ==========================================
# Keep system diagnostics and runtime logs out of the repo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache

# ==========================================
# 5. IDE, EDITORS & SYSTEM JUNK
# ==========================================
# User-specific preferences and OS-generated system files
.vscode/
.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db




